diff --git a/exllamav3/exllamav3_ext/cpu/arm_stubs.cpp b/exllamav3/exllamav3_ext/cpu/arm_stubs.cpp
new file mode 100644
index 0000000..cc4eba1
--- /dev/null
+++ b/exllamav3/exllamav3_ext/cpu/arm_stubs.cpp
@@ -0,0 +1,65 @@
+// aarch64 stand-ins for x86-only translation units (moe_mul1.cpp,
+// all_reduce_cpu_avx2.cpp, all_reduce_cpu_avx512.cpp), excluded from the build
+// on this architecture by setup.py. Config toggles are no-ops, feature probes
+// report unsupported, compute entry points fail loudly if ever reached.
+#if defined(__aarch64__)
+#include <c10/util/Exception.h>
+#include "moe_mul1.h"
+#include "../parallel/all_reduce_cpu_avx2.h"
+#include "../parallel/all_reduce_cpu_avx512.h"
+
+#define EXL3_ARM_UNAVAILABLE(name) \
+    TORCH_CHECK(false, name ": x86-only CPU path is not available on aarch64")
+
+int64_t exl3_moe_cpu_make_layer(
+    const std::vector<at::Tensor>&, const std::vector<at::Tensor>&, const std::vector<at::Tensor>&,
+    const std::vector<at::Tensor>&, const std::vector<at::Tensor>&, const std::vector<at::Tensor>&,
+    const std::vector<at::Tensor>&, const std::vector<at::Tensor>&, const std::vector<at::Tensor>&,
+    const std::vector<at::Tensor>&, const std::vector<at::Tensor>&, const std::vector<at::Tensor>&,
+    int64_t, double, int64_t)
+{ EXL3_ARM_UNAVAILABLE("exl3_moe_cpu_make_layer"); return -1; }
+
+void exl3_moe_cpu_free_layer(int64_t) {}
+
+void exl3_moe_cpu_forward(int64_t, const at::Tensor&, const at::Tensor&,
+                          const at::Tensor&, at::Tensor&, int64_t)
+{ EXL3_ARM_UNAVAILABLE("exl3_moe_cpu_forward"); }
+
+void exl3_moe_cpu_forward_raw(int64_t, const at::Half*, const int32_t*,
+                              const at::Half*, float*, int, int, int)
+{ EXL3_ARM_UNAVAILABLE("exl3_moe_cpu_forward_raw"); }
+
+void exl3_moe_cpu_stage_experts(int64_t, const uint32_t*, int, uint8_t*, int)
+{ EXL3_ARM_UNAVAILABLE("exl3_moe_cpu_stage_experts"); }
+
+void exl3_moe_cpu_set_prof(bool) {}
+bool exl3_moe_cpu_has_avx2() { return false; }
+bool exl3_moe_cpu_has_avx512_vnni() { return false; }
+bool exl3_moe_cpu_has_avx512_vbmi() { return false; }
+
+// x86 versions set FTZ/DAZ in MXCSR; skipping is safe on aarch64
+void enable_fast_fp() {}
+void enable_fast_fp_avx2() {}
+void enable_fast_fp_avx512() {}
+
+void cpu_reduce_parallel(void (*)(uint16_t*, const uint16_t*, const uint16_t*, size_t),
+                         void (*)(uint16_t*, const uint16_t*, size_t),
+                         uint16_t*, const uint16_t*, const uint16_t*, size_t, int)
+{ EXL3_ARM_UNAVAILABLE("cpu_reduce_parallel"); }
+
+void perform_cpu_reduce(PGContext*, size_t, uint32_t, uint32_t, uint8_t*, size_t)
+{ EXL3_ARM_UNAVAILABLE("perform_cpu_reduce"); }
+void perform_cpu_reduce_avx2(PGContext*, size_t, uint32_t, uint32_t, uint8_t*, size_t)
+{ EXL3_ARM_UNAVAILABLE("perform_cpu_reduce_avx2"); }
+void perform_cpu_reduce_avx512(PGContext*, size_t, uint32_t, uint32_t, uint8_t*, size_t)
+{ EXL3_ARM_UNAVAILABLE("perform_cpu_reduce_avx512"); }
+
+void bf16_add_inplace_avx512(uint16_t*, const uint16_t*, size_t)
+{ EXL3_ARM_UNAVAILABLE("bf16_add_inplace_avx512"); }
+void bf16_add_twosrc_avx512(uint16_t*, const uint16_t*, const uint16_t*, size_t)
+{ EXL3_ARM_UNAVAILABLE("bf16_add_twosrc_avx512"); }
+void fp16_add_inplace_avx512(uint16_t*, const uint16_t*, size_t)
+{ EXL3_ARM_UNAVAILABLE("fp16_add_inplace_avx512"); }
+void fp16_add_twosrc_avx512(uint16_t*, const uint16_t*, const uint16_t*, size_t)
+{ EXL3_ARM_UNAVAILABLE("fp16_add_twosrc_avx512"); }
+#endif
