# Site configuration — copy to site.env and fill in for YOUR hardware.
#   cp scripts/site.env.example scripts/site.env && $EDITOR scripts/site.env
#
# Every script sources scripts/site.env when it exists and falls back to the
# reference pair's values otherwise, so this is the only file you edit.
# Single-node (TP=1) users can ignore everything marked [2x only].

# ---- topology ---------------------------------------------------------------
TP=2                                   # 1 = single Spark, 2 = a pair

# ---- containers -------------------------------------------------------------
C0=ggrun                               # serving container on rank 0
C1=ggbuild                             # [2x only] serving container on rank 1

# ---- paths ------------------------------------------------------------------
WS=/home/code/work/qwen38-exl3         # host work dir, bind-mounted to /ws

# ---- addressing -------------------------------------------------------------
# LAN addresses, used for the LMCache server URLs the engine connects to.
LAN_RANK0=192.168.0.200
LAN_RANK1=192.168.0.174                # [2x only]

# [2x only] Point-to-point fabric addresses over one direct cable (ray + NCCL
# bootstrap). Any /30 or /24 works; these must already be configured.
FABRIC_RANK0=198.18.200.1
FABRIC_RANK1=198.18.200.2

# ---- fabric devices [2x only] ----------------------------------------------
# The four ConnectX-7 netdevs, in cable order. Check with: ip -br link
NETDEV1=enp1s0f0np0
NETDEV2=enp1s0f1np1
NETDEV3=enP2p1s0f0np0
NETDEV4=enP2p1s0f1np1

# RDMA device names for ONE PORT ON EACH CARD (both ports of a card share one
# PCIe x4 link, so pairing them buys nothing). Check with: ibv_devices
RDMA_CARD1=rocep1s0f0
RDMA_CARD2=roceP2p1s0f0

# GID index whose entry is the per-cable /24 address (RoCEv2). Find with:
#   cat /sys/class/infiniband/<dev>/ports/1/gids/<n>
NCCL_GID_INDEX=5

# Per-cable rail subnets, added alongside the point-to-point addresses.
RAIL_PREFIX=10.42                      # -> 10.42.{1..4}.{1,2}/24
