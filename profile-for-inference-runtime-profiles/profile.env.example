# Sanitized two-node profile. Copy to a private .env on each node.
# Never commit the populated file.

# --- identity -------------------------------------------------------------
NODE_RANK=REPLACE_WITH_0_OR_1
WORK_DIR=REPLACE_WITH_HOST_WORK_DIR          # bind-mounted to /ws in every container
MODEL_DIR=${WORK_DIR}/model/Qwen3.8-27B-EXL3-K5K6-hydrated
LMCACHE_L2_DIR=${WORK_DIR}/lmcache-l2        # NVMe-backed
LOG_DIR=${WORK_DIR}/logs

# --- images ---------------------------------------------------------------
# No published runtime image; the runtime is built from source in-container on
# top of this base (see the recipe repository named in manifest.json).
BASE_IMAGE=nvcr.io/nvidia/cuda@sha256:5c36750138dc1447a17dafbb397674f167d3b44ce18d9160d769df114577b35d
RUNTIME_IMAGE=REPLACE_WITH_LOCALLY_BUILT_RUNTIME_TAG

# --- addressing -----------------------------------------------------------
# LAN addresses: how the two LMCache servers find each other, and where the
# OpenAI-compatible endpoint is published.
RANK0_LAN_ADDR=REPLACE_WITH_RANK0_LAN_ADDRESS
RANK1_LAN_ADDR=REPLACE_WITH_RANK1_LAN_ADDRESS
API_PORT=8000

# Fabric addresses: one direct cable carries ray and the NCCL bootstrap.
RANK0_FABRIC_ADDR=REPLACE_WITH_RANK0_FABRIC_ADDRESS
RANK1_FABRIC_ADDR=REPLACE_WITH_RANK1_FABRIC_ADDRESS
RAY_PORT=6379

# Bootstrap interface (the netdev holding the fabric address on this node).
FABRIC_IFACE=REPLACE_WITH_FABRIC_INTERFACE

# --- transport (two-rail striping) ----------------------------------------
# One port per ConnectX-7 card. Pairing two ports of the SAME card gains
# nothing: they share one PCIe Gen5 x4 link (~110 Gb/s).
NCCL_IB_HCA=REPLACE_WITH_CARD1_PORT0_RDMA_DEVICE,REPLACE_WITH_CARD2_PORT0_RDMA_DEVICE
NCCL_IB_GID_INDEX=5
NCCL_IB_SUBNET_AWARE_ROUTING=0               # REQUIRED for parallel rails between one rank pair
NCCL_IB_MERGE_NICS=0
NCCL_CROSS_NIC=1
NCCL_MIN_NCHANNELS=2
NCCL_MAX_NCHANNELS=2
NCCL_ALGO=Ring
NCCL_CUMEM_ENABLE=0
PATCHED_NCCL_LIBRARY=${WORK_DIR}/nccl-patched/libnccl.so.2
PATCHED_NCCL_LIBRARY_SHA256=e69a8c240f45d10166bcd901d99db78bb63147adda66e586d8dd505c6d608b54

# Per-cable rail subnets, one distinct /24 per cable, rank0 host .1 / rank1 .2.
# Added additively alongside whatever addressing already exists on the links.
RAIL_SUBNETS=10.42.1.0/24,10.42.2.0/24,10.42.3.0/24,10.42.4.0/24
RAIL_IFACES=REPLACE_WITH_COMMA_SEPARATED_CABLE_INTERFACES

# --- LMCache tier ---------------------------------------------------------
LMCACHE_PORT=6556
LMCACHE_INSTANCE_ID=qwen38-r${NODE_RANK}-cs1600
LMCACHE_CHUNK_SIZE=1600                      # must equal the model's mamba block
LMCACHE_L1_GB=4                              # >= the longest prefix you expect to replay
LMCACHE_L2_CAP_GB=200
LMCACHE_GPU_WORKERS=2
LMCACHE_CPU_WORKERS=2
LMCACHE_MQ_TIMEOUT=60
LMCACHE_HEARTBEAT_INTERVAL=10

# --- engine gates ---------------------------------------------------------
LMC=1                                        # LMCache connector on
APC=1                                        # prefix caching + mamba-cache-mode align
STRIPE=2                                     # two-rail patched-NCCL transport
MTPK=2                                       # MTP depth (3 = interactive alternative)
KVDTYPE=fp8
STAGE=graph                                  # EXL3 CUDA-graph decode
BATCHTOK=3072                                # MUST be in [1600, 3200) while LMC=1
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=64
GPU_MEMORY_UTILIZATION=0.40
SERVED_MODEL_NAME=qwen38
